<h1>Question #<%= @question.id %></h1>

<%= link_to 'Back to list', questions_path %>

<% if notice %>
  <div style="color: green; padding: 10px; background: #d4edda; margin: 10px 0;">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div style="color: red; padding: 10px; background: #f8d7da; margin: 10px 0;">
    <%= alert %>
  </div>
<% end %>

<hr>

<article>
  <header>
    <h2><%= @question.title %></h2>
    <small>
      Created: <%= @question.created_at.strftime('%d.%m.%Y в %H:%M') %>
    </small>
  </header>
  
  <section>
    <%= simple_format(@question.body) %>
  </section>
</article>

<hr>

<nav>
    <%= link_to 'Edit the question', edit_question_path(@question) %> |
    <%= link_to 'Delet a question', @question, 
        data: { 
          turbo_method: :delete, 
          turbo_confirm: 'Are you sure you want to delete this question?' 
        } %>
</nav>

<hr>

<h3>Answers (<%= @question.answers.count %>)</h3>

<% if @question.answers.any? %>
  <% @question.answers.each do |ans| %>
    <article style="border: 1px solid #ddd; padding: 10px; margin: 10px 0;">
      <%= simple_format(ans.body) %>
      <small>
        Создан: <%= ans.created_at.strftime('%d.%m.%Y в %H:%M') %>
        <%= link_to 'Edit the answer', question_path(@question, edit_answer_id: ans.id) %> |
        <%= link_to 'Delete a answer', question_answer_path(@question, ans), 
                data: { 
                  turbo_method: :delete, 
                  turbo_confirm: 'Are you sure you want to delete this answer?' 
                } %>
      </small>
    </article>
  <% end %>
<% else %>
  <p>There are no answers yet. Be the first!</p>
<% end %>

<hr>

<h3>Your answer</h3>

<%= form_with model: [@question, @answer], local: true do |f| %>
  <% if @answer.errors.any? %>
    <div style="color: red; padding: 10px; background: #f8d7da; margin: 10px 0;">
      <h4>Errors:</h4>
      <ul>
        <% @answer.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.text_area :body, placeholder: "Write your answer here...", rows: 5, style: "width: 100%;" %>
  <br>
  <%= f.submit "Send a answer", style: "margin-top: 10px;" %>
  
  <% if params[:edit_answer_id] %>
    <%= link_to 'Cancel', question_path(@question) %>
  <% end %>
<% end %>
