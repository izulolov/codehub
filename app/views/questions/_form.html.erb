<%= form_with model: @question, local: true do |f| %>
  <% if @question.errors.any? %>
    <div class="errors" style="color: red; background: #ffe6e6; padding: 10px; margin-bottom: 20px; border: 1px solid red;">
      <h3>Found <%= @question.errors.count %> errors when saving:</h3>
      <ul>
        <% @question.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <p>
    <%= f.label :title, "Title" %><br>
    <%= f.text_field :title, placeholder: 'For example: How does closure work in JavaScript?', size: 50 %>
  </p>
  
  <p>
    <%= f.label :body, "Body" %><br>
    <%= f.text_area :body, rows: 10, cols: 50, placeholder: 'Describe your problem in detail...' %>
  </p>
  
  <p>
    <%= f.submit @question.new_record? ? 'Create question' : 'Update question' %>
    <% if @question.persisted? %>
      <%= link_to 'Cancel', question_path(@question) %>
    <% else %>
      <%= link_to 'Cancel', questions_path %>
    <% end %>
  </p>
<% end %>
