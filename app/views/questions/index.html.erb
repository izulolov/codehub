<h1>All questions on the CodeHub website</h1>

<%= link_to 'Create question', new_question_path %>

<% if @questions.any? %>
  <% @questions.each do |question| %>
    <div>
      <h3><%= link_to question.title, question_path(question) %></h3>
      <p><%= truncate(question.body, length: 200) %></p>
      <small>Created: <%= time_ago_in_words(question.created_at) %> ago</small>
      <hr>
    </div>
  <% end %>
<% else %>
  <p>There are no questions yet. Be the first!</p>
<% end %>
